# Secrets and local state — never commit these
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data: database, originals, previews, exports, per-account workspaces
/data/

# Local backup output from scripts/backup.py (contains .env and session state)
/backups/

# Third-party gateway checkout (installed by scripts/prepare_gateway.py)
/vendor/

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
desktop.ini
