# Do not use this file as-is; run python scripts/bootstrap.py to create unique secrets.
APP_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SECRET
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS
AGENT_API_KEY=REPLACE_WITH_RANDOM_BEARER_TOKEN
COOKIE_SECURE=false
MAX_RUNNING_ACCOUNTS=2
# SQLite by default; optional PostgreSQL with pip install 'psycopg[binary]':
# DATABASE_URL=postgresql+psycopg://ninja:strong_db_password@localhost:5432/ninja
# DATA_DIR=./data
# v0.3: bounded queue and concurrency; these do not override provider limits
GLOBAL_MAX_INFLIGHT=4
GATEWAY_MAX_TABS=3
MAX_PENDING_JOBS=1000
MAX_BATCH_IMAGES=4
PROVIDER_COOLDOWN_MINUTES=30
# On-demand workers: stop an idle browser after N minutes and wake it automatically on the
# next job or when the login page is opened. 0 keeps every browser always-on (RAM heavy).
# Live-editable in the panel (Operations) once the database exists.
IDLE_WORKER_SHUTDOWN_MINUTES=20

# Phase 4 operations (live-editable in Operations after first start):
# Derived previews older than N days are deleted; originals are never touched. 0 disables.
PREVIEW_RETENTION_DAYS=30
# Leftover export ZIPs older than N hours are deleted. 0 disables.
EXPORT_RETENTION_HOURS=24
# A stopped worker's log is rotated above this size (MB). 0 disables.
WORKER_LOG_MAX_MB=20
# Below this free disk, new dispatch pauses (queued jobs are kept). 0 disables the guard.
MIN_FREE_DISK_MB=500
